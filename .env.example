# Runtime environment
LOCO_ENV=development

# Server
PORT=3000
BINDING=0.0.0.0
LOG_LEVEL=info

# DB (SQLite lives under storage/, mounted at /app/storage on Dokku)
DATABASE_URL=sqlite://storage/development.sqlite3?mode=rwc
DB_MAX_CONNECTIONS=5

# Auth
JWT_SECRET=change-me

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# Upload (unofficial LIHKG image host)
LIHKG_UPLOAD_URL=https://img.eservice-hk.net/api.php?version=2
LIHKG_ALLOWED_HOSTS=img.eservice-hk.net
MAX_UPLOAD_BYTES=10485760
LIHKG_CIRCUIT_FAILURES=5
LIHKG_CIRCUIT_COOLDOWN=60

# AI
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_ENABLED=true
AI_CACHE_HOURS=24

# Business
TZ=Asia/Hong_Kong
RECURRING_BACKFILL_ENABLED=false
RECURRING_BACKFILL_MAX_DAYS=90
