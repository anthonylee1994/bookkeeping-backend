NODE_ENV=test
TZ=Asia/Hong_Kong
LOG_LEVEL=silent
DATABASE_URL=file:../storage/test.sqlite3
JWT_SECRET=test-jwt-secret
CORS_ORIGINS=
LIHKG_ALLOWED_HOSTS=127.0.0.1
MAX_UPLOAD_BYTES=10485760
LIHKG_CIRCUIT_FAILURES=5
LIHKG_CIRCUIT_COOLDOWN=60
