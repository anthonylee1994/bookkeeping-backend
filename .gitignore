# Rust
/target/
**/*.rs.bk

# Environment
/.env
/.env.*
!.env.example

# SQLite databases + runtime data
/storage/*
!/storage/.keep
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Logs / temp
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
!/tmp/pids/
!/tmp/pids/.keep

# Dokku local overrides (never commit secrets / machine-specific setup)
/bin/dokku-setup.sh
/docs/dokku-setup.local.md

# Coverage / editor
/coverage/
.DS_Store
.idea/
.vscode/
