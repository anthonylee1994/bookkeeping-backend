#!/usr/bin/env bash
# Copy to bin/dokku-setup.sh (gitignored) and fill in secrets before running.
set -euo pipefail

APP=bookkeeping-backend

dokku apps:create "$APP" || true
dokku storage:ensure-directory "$APP"
dokku storage:mount "$APP" "/var/lib/dokku/data/storage/$APP/storage:/app/storage"
dokku domains:set "$APP" book-api.on99.app
dokku certs:add "$APP" < /root/certs/on99.app.tar
dokku checks:enable "$APP"
dokku checks:set "$APP" web.wait-to-retire 30
dokku checks:set "$APP" web.initial-delay 10
dokku config:set --no-restart "$APP" \
  LOCO_ENV=production \
  BINDING=0.0.0.0 \
  DATABASE_URL='sqlite:///app/storage/production.sqlite3?mode=rwc' \
  JWT_SECRET=... \
  CORS_ORIGINS=https://book.on99.app \
  LIHKG_UPLOAD_URL='https://img.eservice-hk.net/api.php?version=2' \
  LIHKG_ALLOWED_HOSTS=img.eservice-hk.net \
  DEEPSEEK_API_KEY=... \
  DEEPSEEK_MODEL=deepseek-flash \
  DEEPSEEK_VISION_ENABLED=true \
  TZ=Asia/Hong_Kong \
  RECURRING_BACKFILL_ENABLED=false \
  RECURRING_BACKFILL_MAX_DAYS=90 \
  AI_CACHE_HOURS=24
dokku ps:scale "$APP" web=1
